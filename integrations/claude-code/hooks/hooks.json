{
  "description": "Blocks unsafe PostgreSQL DDL before it is written to a migration file or executed by a migration runner.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.js\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
