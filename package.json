{
  "name": "migrationpilot",
  "version": "1.5.1",
  "description": "Know exactly what your PostgreSQL migration will do to production — before you merge.",
  "mcpName": "io.github.mickelsamuel/migrationpilot",
  "type": "module",
  "bin": {
    "migrationpilot": "./dist/cli.cjs",
    "migrationpilot-mcp": "./dist/mcp.cjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": "./dist/mcp.cjs"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node scripts/build.js",
    "build:playground": "node scripts/build-playground.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "migration",
    "database",
    "schema",
    "safety",
    "linter",
    "ci",
    "github-action",
    "devops",
    "ddl",
    "sql",
    "lint",
    "static-analysis",
    "zero-downtime",
    "lock",
    "pg",
    "migration-safety"
  ],
  "bugs": {
    "url": "https://github.com/mickelsamuel/migrationpilot/issues"
  },
  "funding": {
    "url": "https://migrationpilot.dev/#pricing"
  },
  "author": "Mickel Samuel <mickelsamuel.b@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mickelsamuel/migrationpilot"
  },
  "homepage": "https://migrationpilot.dev",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@electric-sql/pglite": "^0.5.4",
    "@pgsql/types": "^17.6.2",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "libpg-query": "^17.7.4",
    "pg": "^8.23.0",
    "pgsql-parser": "^17.9.11",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.21.0",
    "@vercel/node": "^5.9.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^20.3.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@electric-sql/pglite"
    ],
    "overrides": {
      "undici@<6.28.0": "^6.28.0",
      "minimatch@<10.2.6": "^10.2.6",
      "brace-expansion@<5.0.9": "^5.0.9",
      "ajv@<6.14.0": "~6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
      "fast-uri@<3.1.5": "^3.1.5",
      "path-to-regexp@>=4.0.0 <6.3.0": ">=6.3.0",
      "path-to-regexp@>=8.0.0 <8.4.0": "^8.4.0",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "hono@<4.12.34": "^4.12.34",
      "@hono/node-server@<2.0.5": "^2.0.5",
      "express-rate-limit@<8.2.2": "^8.2.2",
      "ip-address@<10.3.1": "^10.3.1",
      "qs@<6.15.2": "^6.15.2",
      "body-parser@<2.3.0": "^2.3.0",
      "tar@<7.5.21": "^7.5.21",
      "js-yaml@>=4.0.0 <4.3.1": "^4.3.1",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "smol-toml@<1.6.1": "^1.6.1",
      "flatted@<3.4.2": "^3.4.2",
      "tsx@<4.23.12": "^4.23.12"
    }
  }
}
